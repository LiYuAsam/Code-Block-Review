{
  "name": "code-block-review",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.1.2",
  "publisher": "liyuasam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LiYuAsam/Code-Block-Review.git"
  },
  "bugs": {
    "url": "https://github.com/LiYuAsam/Code-Block-Review/issues"
  },
  "homepage": "https://github.com/LiYuAsam/Code-Block-Review#readme",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "review",
    "diff",
    "patch",
    "ai",
    "code-review",
    "developer-tools"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:codexReview.startSession",
    "onCommand:codexReview.stopSession",
    "onCommand:codexReview.completeReview",
    "onCommand:codexReview.openReviewPanel",
    "onView:codexReview.filesView"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codexReview.startSession",
        "title": "%command.startSession.title%",
        "category": "%command.category%"
      },
      {
        "command": "codexReview.stopSession",
        "title": "%command.stopSession.title%",
        "category": "%command.category%"
      },
      {
        "command": "codexReview.completeReview",
        "title": "%command.completeReview.title%",
        "category": "%command.category%"
      },
      {
        "command": "codexReview.refreshReview",
        "title": "%command.refreshReview.title%",
        "category": "%command.category%"
      },
      {
        "command": "codexReview.openBlock",
        "title": "%command.openBlock.title%",
        "category": "%command.category%"
      },
      {
        "command": "codexReview.previewBlock",
        "title": "%command.previewBlock.title%",
        "category": "%command.category%"
      },
      {
        "command": "codexReview.openReviewPanel",
        "title": "%command.openReviewPanel.title%",
        "category": "%command.category%"
      },
      {
        "command": "codexReview.acceptBlock",
        "title": "%command.acceptBlock.title%",
        "category": "%command.category%"
      },
      {
        "command": "codexReview.rejectBlock",
        "title": "%command.rejectBlock.title%",
        "category": "%command.category%"
      },
      {
        "command": "codexReview.acceptFile",
        "title": "%command.acceptFile.title%",
        "category": "%command.category%"
      },
      {
        "command": "codexReview.rejectFile",
        "title": "%command.rejectFile.title%",
        "category": "%command.category%"
      },
      {
        "command": "codexReview.showProfilerOutput",
        "title": "%command.showProfilerOutput.title%",
        "category": "%command.category%"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "codexReview.filesView",
          "name": "%view.files.name%"
        }
      ]
    },
    "configuration": [
      {
        "title": "%configuration.general.title%",
        "type": "object",
        "properties": {
          "codexReview.ignoredFileGlobs": {
            "type": "array",
            "default": [
              "**/pnpm-lock.yaml",
              "**/package-lock.json",
              "**/yarn.lock"
            ],
            "items": {
              "type": "string"
            },
            "description": "%configuration.ignoredFileGlobs.description%",
            "order": 1
          }
        }
      },
      {
        "title": "%configuration.display.title%",
        "type": "object",
        "properties": {
          "codexReview.showBlockBadges": {
            "type": "boolean",
            "default": false,
            "description": "%configuration.showBlockBadges.description%",
            "order": 1
          }
        }
      },
      {
        "title": "%configuration.autoCapture.title%",
        "type": "object",
        "properties": {
          "codexReview.autoCapture.enabled": {
            "type": "boolean",
            "order": 1,
            "default": true,
            "description": "%configuration.autoCapture.enabled.description%"
          },
          "codexReview.autoCapture.triggerEvents": {
            "type": "array",
            "order": 2,
            "default": [
              "windowFocus",
              "activeEditorChange"
            ],
            "items": {
              "type": "string",
              "enum": [
                "windowFocus",
                "activeEditorChange"
              ],
              "enumDescriptions": [
                "%configuration.autoCapture.triggerEvents.windowFocus%",
                "%configuration.autoCapture.triggerEvents.activeEditorChange%"
              ]
            },
            "uniqueItems": true,
            "description": "%configuration.autoCapture.triggerEvents.description%"
          }
        }
      },
      {
        "title": "%configuration.autoCaptureScope.title%",
        "type": "object",
        "properties": {
          "codexReview.autoCapture.scope": {
            "type": "string",
            "order": 1,
            "default": "touchedProjects",
            "enum": [
              "workspace",
              "activeProject",
              "touchedProjects"
            ],
            "enumDescriptions": [
              "%configuration.autoCapture.scope.workspace%",
              "%configuration.autoCapture.scope.activeProject%",
              "%configuration.autoCapture.scope.touchedProjects%"
            ],
            "description": "%configuration.autoCapture.scope.description%"
          },
          "codexReview.autoCapture.projectRootMarkers": {
            "type": "array",
            "order": 2,
            "default": [
              "package.json",
              "go.mod",
              "go.work",
              "pom.xml",
              "build.gradle",
              "settings.gradle",
              "pyproject.toml",
              "Cargo.toml",
              "composer.json",
              "CMakeLists.txt",
              "Makefile",
              ".project-root",
              ".git"
            ],
            "items": {
              "type": "string"
            },
            "description": "%configuration.autoCapture.projectRootMarkers.description%"
          }
        }
      },
      {
        "title": "%configuration.autoCaptureTiming.title%",
        "type": "object",
        "properties": {
          "codexReview.autoCapture.baselineRefreshCooldownSeconds": {
            "type": "number",
            "order": 1,
            "default": 10,
            "minimum": 0,
            "maximum": 3600,
            "description": "%configuration.autoCapture.baselineRefreshCooldownSeconds.description%"
          },
          "codexReview.autoCapture.captureIdleSeconds": {
            "type": "number",
            "order": 2,
            "default": 4,
            "minimum": 1,
            "maximum": 600,
            "description": "%configuration.autoCapture.captureIdleSeconds.description%"
          },
          "codexReview.autoCapture.reviewOfferSeconds": {
            "type": "number",
            "order": 3,
            "default": 120,
            "minimum": 0,
            "maximum": 600,
            "description": "%configuration.autoCapture.reviewOfferSeconds.description%"
          },
          "codexReview.autoCapture.observationWindowSeconds": {
            "type": "number",
            "order": 4,
            "default": 1.2,
            "minimum": 0.1,
            "maximum": 60,
            "description": "%configuration.autoCapture.observationWindowSeconds.description%"
          },
          "codexReview.autoCapture.burstEventWindowMilliseconds": {
            "type": "number",
            "order": 5,
            "default": 500,
            "minimum": 50,
            "maximum": 10000,
            "description": "%configuration.autoCapture.burstEventWindowMilliseconds.description%"
          }
        }
      },
      {
        "title": "%configuration.autoCaptureThresholds.title%",
        "type": "object",
        "properties": {
          "codexReview.autoCapture.largeChangeLines": {
            "type": "number",
            "order": 1,
            "default": 8,
            "minimum": 1,
            "maximum": 10000,
            "description": "%configuration.autoCapture.largeChangeLines.description%"
          },
          "codexReview.autoCapture.largeChangeChars": {
            "type": "number",
            "order": 2,
            "default": 200,
            "minimum": 1,
            "maximum": 1000000,
            "description": "%configuration.autoCapture.largeChangeChars.description%"
          },
          "codexReview.autoCapture.multiFileMinFiles": {
            "type": "number",
            "order": 3,
            "default": 2,
            "minimum": 1,
            "maximum": 1000,
            "description": "%configuration.autoCapture.multiFileMinFiles.description%"
          },
          "codexReview.autoCapture.multiFileMinLines": {
            "type": "number",
            "order": 4,
            "default": 8,
            "minimum": 1,
            "maximum": 100000,
            "description": "%configuration.autoCapture.multiFileMinLines.description%"
          },
          "codexReview.autoCapture.burstMinEvents": {
            "type": "number",
            "order": 5,
            "default": 10,
            "minimum": 1,
            "maximum": 10000,
            "description": "%configuration.autoCapture.burstMinEvents.description%"
          },
          "codexReview.autoCapture.burstMinLines": {
            "type": "number",
            "order": 6,
            "default": 18,
            "minimum": 1,
            "maximum": 100000,
            "description": "%configuration.autoCapture.burstMinLines.description%"
          }
        }
      },
      {
        "title": "%configuration.diagnostics.title%",
        "type": "object",
        "properties": {
          "codexReview.profiler.enabled": {
            "type": "boolean",
            "default": false,
            "description": "%configuration.profiler.enabled.description%",
            "order": 1
          }
        }
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codexReview.startSession",
          "when": "view == codexReview.filesView && !codexReview.isCapturing && !codexReview.isReviewing",
          "group": "navigation@1"
        },
        {
          "command": "codexReview.stopSession",
          "when": "view == codexReview.filesView && codexReview.isCapturing",
          "group": "navigation@2"
        },
        {
          "command": "codexReview.completeReview",
          "when": "view == codexReview.filesView && codexReview.isReviewing",
          "group": "navigation@3"
        },
        {
          "command": "codexReview.refreshReview",
          "when": "view == codexReview.filesView && codexReview.hasSession",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "codexReview.openReviewPanel",
          "when": "view == codexReview.filesView && viewItem == file && codexReview.isReviewing",
          "group": "inline@1"
        }
      ]
    }
  },
  "scripts": {
    "check": "node -c src/extension.js",
    "vscode:prepublish": "npm run check"
  }
}
